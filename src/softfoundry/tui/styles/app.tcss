/* softfoundry TUI — Dark Minimal Theme */

Screen {
    background: $background;
    layout: vertical;
}

/* ─── Main Layout ─── */

#main-container {
    layout: horizontal;
    height: 1fr;
    margin: 0 0 1 0;
    padding: 0;
}

#left-column {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

/* ─── Message Stream ─── */

MessageStream {
    width: 1fr;
    height: 1fr;
    background: $background;
    scrollbar-size: 1 1;
    margin: 1 1 1 1;
}

/* ─── Sidebar ─── */

Sidebar {
    width: 30;
    height: 1fr;
    background: $panel;
    overflow-y: auto;
    padding: 1;
    margin: 0;
}

Sidebar.hidden {
    display: none;
}

/* All sidebar section widgets must shrink to content */
AgentStatusSection {
    height: auto;
}

SessionSection {
    height: auto;
}

TaskSection {
    height: auto;
}

EpicProgressSection {
    height: auto;
}

#epic-issues {
    height: auto;
}

KeyBindingsSection {
    height: auto;
}

/* ─── Input Area ─── */

InputArea {
    height: auto;
    max-height: 12;
    margin: 1 1 0 1;
}

#input-container {
    height: auto;
    max-height: 12;
    background: $panel;
}

#input-area {
    height: auto;
    min-height: 4;
    max-height: 10;
    background: $panel;
    margin: 1;
    border: none;
}

#input-area:focus {
    border: none;
}

#input-area .text-area--cursor-line {
    background: $panel;
}

#input-disabled-label {
    height: 1;
    color: $text-muted;
    text-style: italic;
}

/* ─── Status Bar (Footer) ─── */

StatusBar {
    height: 1;
    background: $primary-background;
    color: $text-muted;
    padding: 0 1 0 1;
}

/* ─── Message Blocks ─── */

.message-block {
    width: 1fr;
    height: auto;
    background: $background;
    margin: 0 0 1 0;
}

/* Assistant text */
.text-message {
}

/* User message */
.user-message {
    color: $accent;
}

/* Question block */
.question-block {
    background: $panel;
    border: tall $accent;
    padding: 0 1;
    height: auto;
}

.question-text {
    color: $accent;
    text-style: bold;
    height: auto;
}

.question-option {
    color: $text;
    height: auto;
}

.question-hint {
    color: $text-muted;
    text-style: italic;
    height: auto;
}

/* Collapsible blocks (thinking, tool use) */

.collapsible {
    width: 1fr;
    height: auto;
    background: $background;
}

/* Tool blocks get a distinct grey box */
.tool-block {
    background: $surface;
    padding: 0 1;
}

.collapsible-header {
    height: 1;
    width: 1fr;
    color: $text-muted;
}

.collapsible-header:hover {
    color: $text;
    background: $boost;
}

.collapsible-content {
    color: $text-muted;
    height: auto;
}

.collapsible-content.hidden {
    display: none;
}

/* Result block */
.result-block {
    height: auto;
}

.result-rule-success {
    color: $success;
    height: auto;
}

.result-rule-error {
    color: $error;
    height: auto;
}

.result-info {
    color: $text-muted;
    height: auto;
}

/* System block */
.system-block {
    color: $secondary;
}

/* ─── Sidebar Sections ─── */

.sidebar-title {
    color: $text-muted;
    text-style: bold;
    height: auto;
}

.sidebar-separator {
    color: $primary-background-lighten-2;
    height: 1;
    max-height: 1;
}

.session-value {
    color: $text;
    height: auto;
}

.task-info {
    color: $text;
    height: auto;
}

/* Epic progress */
.epic-issue {
    height: 1;
}

.epic-done {
    color: $success;
}

.epic-active {
    color: $warning;
}

.epic-pending {
    color: $text-muted;
}

.epic-blocked {
    color: $error;
}

/* ─── Session separator ─── */

.session-separator {
    color: $accent;
    text-style: bold;
    height: 1;
    margin: 1 0;
}

/* ─── Lifecycle messages ─── */

.lifecycle-success {
    color: $success;
    text-style: bold;
}

.lifecycle-error {
    color: $error;
    text-style: bold;
}

.lifecycle-warning {
    color: $warning;
}

.lifecycle-info {
    color: $text-muted;
    text-style: italic;
}
